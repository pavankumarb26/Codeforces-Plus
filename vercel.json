{
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://codeforces-plus.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
